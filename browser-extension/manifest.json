{
  "manifest_version": 3,
  "name": "Openguin Network Watch",
  "version": "0.6.0",
  "description": "Opt-in active-tab diagnostics with strict monitoring-session isolation, reliable stop, and local browser evidence.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_permissions": [
    "downloads",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Openguin Network Watch",
    "default_popup": "popup.html"
  }
}
