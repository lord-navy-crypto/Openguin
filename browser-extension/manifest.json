{
  "manifest_version": 3,
  "name": "Openguin Network Watch",
  "version": "0.2.0",
  "description": "Opt-in, local-only diagnostics with correlated request lifecycles, resource failures, JavaScript errors, and response-gap analysis.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_permissions": ["downloads", "alarms"],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Openguin Network Watch",
    "default_popup": "popup.html"
  }
}
