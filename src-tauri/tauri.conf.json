{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModelDock",
  "version": "0.7.0",
  "identifier": "app.modeldock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"ModelDock","width":1380,"height":860,"minWidth":1050,"minHeight":680,"center":true}],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:11434 http://127.0.0.1:11435 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "resources": {
      "resources/ollama-runtime/": "ollama-runtime/"
    }
  }
}
