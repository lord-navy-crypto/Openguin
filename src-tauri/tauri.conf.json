{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Openguin",
  "version": "0.10.1",
  "identifier": "app.modeldock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"Openguin","width":1380,"height":860,"minWidth":1050,"minHeight":680,"center":true}],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:11434 http://127.0.0.1:11435 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "dmg": {
        "appPosition": {"x": 180, "y": 220},
        "applicationFolderPosition": {"x": 480, "y": 220}
      }
    }
  }
}
