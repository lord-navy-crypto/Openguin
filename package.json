{
  "name": "openguin-preview",
  "private": true,
  "version": "0.10.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify:desktop": "python3 scripts/verify-desktop.py",
    "verify:brand": "python3 scripts/verify-brand011.py",
    "verify:engineering": "python3 scripts/verify-engineering011.py",
    "verify:prepared": "python3 scripts/verify-prepared-backend.py",
    "verify:legacy": "python3 scripts/verify-legacy-hardening011.py",
    "verify:core-state": "python3 scripts/verify-core-state011.py",
    "verify:release-gate": "python3 scripts/verify-release-gate011.py && python3 scripts/validate-mac011.py --self-check",
    "verify:runtime-consent": "python3 scripts/verify-runtime-consent011.py",
    "verify:library-ultra": "python3 scripts/verify-library-ultra013.py",
    "verify:library-portfolio": "python3 scripts/verify-library-portfolio013.py",
    "verify:all": "npm run verify:desktop && npm run verify:brand && npm run verify:engineering && npm run verify:prepared && npm run verify:legacy && npm run verify:core-state && npm run verify:release-gate && npm run verify:runtime-consent && npm run verify:library-ultra && npm run verify:library-portfolio",
    "desktop:prepare": "python3 scripts/ensure-app-icon.py",
    "desktop:dev": "npm run desktop:prepare && npm run verify:all && tauri dev",
    "desktop:build": "npm run desktop:prepare && npm run verify:all && tauri build",
    "prepare:private-runtime:manual": "bash scripts/prepare-ollama-sidecar.sh",
    "validate:mac": "python3 scripts/validate-mac011.py",
    "validate:mac:private": "python3 scripts/validate-mac011.py --require-private"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@tauri-apps/cli": "^2.0.0"
  }
}
